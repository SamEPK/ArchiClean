{
  "info": {
    "name": "ArchiClean Advisor API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Advisor flows with auto JWT propagation"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "advisorEmail", "value": "advisor@example.com" },
    { "key": "advisorPassword", "value": "ChangeMe123" },
    { "key": "advisorToken", "value": "" },
    { "key": "clientId", "value": "client-123" },
    { "key": "conversationId", "value": "conv-123" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Advisor",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{advisorEmail}}\",\n  \"password\": \"{{advisorPassword}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/advisors/register",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","register"]
            }
          }
        },
        {
          "name": "Login Advisor (sets token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.token) {",
                  "  pm.environment.set('advisorToken', res.token);",
                  "  pm.collectionVariables.set('advisorToken', res.token);",
                  "  console.log('Token updated');",
                  "} else {",
                  "  console.warn('No token in response');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{advisorEmail}}\",\n  \"password\": \"{{advisorPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/advisors/login",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","login"]
            }
          }
        }
      ]
    },
    {
      "name": "Credits",
      "item": [
        {
          "name": "Grant Credit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{advisorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"amount\": 20000,\n  \"annualRate\": 3.2,\n  \"insuranceRate\": 0.3,\n  \"durationMonths\": 60\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/advisors/credits",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","credits"]
            }
          }
        },
        {
          "name": "List Client Credits (query side)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{advisorToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/advisors/clients/{{clientId}}/credits",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","clients","{{clientId}}","credits"]
            }
          }
        }
      ]
    },
    {
      "name": "Messaging",
      "item": [
        {
          "name": "List Open Conversations",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{advisorToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/advisors/conversations/open",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","conversations","open"]
            }
          }
        },
        {
          "name": "Reply to Conversation (claims first)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{advisorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Bonjour, je prends en charge.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/advisors/conversations/{{conversationId}}/reply",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","conversations","{{conversationId}}","reply"]
            }
          }
        },
        {
          "name": "Assign Conversation to Self",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{advisorToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/advisors/conversations/{{conversationId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","conversations","{{conversationId}}","assign"]
            }
          }
        },
        {
          "name": "Transfer Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{advisorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"toAdvisorId\": \"advisor-2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/advisors/conversations/{{conversationId}}/transfer",
              "host": ["{{baseUrl}}"],
              "path": ["advisors","conversations","{{conversationId}}","transfer"]
            }
          }
        }
      ]
    }
  ]
}
